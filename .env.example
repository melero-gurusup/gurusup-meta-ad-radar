# Token de ScrapeCreators, que es quien sirve la Biblioteca de Anuncios de Meta.
# Se saca en https://scrapecreators.com — al registrarte te dan 100 créditos
# gratis sin tarjeta, y hasta 7.000 más de bonus. Un barrido de 15 marcas
# cuesta unos 25 créditos. No hay suscripción y los créditos no caducan.
#
# El mismo token vale para el barrido y para el servidor MCP: setup.sh lo lee
# de aquí y se lo pasa al MCP al registrarlo.
SCRAPECREATORS_API_KEY=

# Opcional, solo para analizar anuncios en vídeo con el MCP.
# Se saca en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
